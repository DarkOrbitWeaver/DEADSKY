<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══ COLORS ════════════════════════════════════════════════════════ -->
    <Color x:Key="ConsoleBg">#0A0C0A</Color>
    <Color x:Key="PanelBg">#0F140F</Color>
    <Color x:Key="PanelBorder">#1E3C1E</Color>
    <Color x:Key="PanelHeader">#142014</Color>

    <Color x:Key="RadarBg">#050F05</Color>
    <Color x:Key="RadarSweep">#00FF00</Color>
    <Color x:Key="RadarGrid">#005000</Color>
    <Color x:Key="RadarText">#00C800</Color>

    <Color x:Key="Hostile">#FF3232</Color>
    <Color x:Key="Friendly">#3296FF</Color>
    <Color x:Key="Unknown">#FFFF32</Color>
    <Color x:Key="Neutral">#32FF32</Color>
    <Color x:Key="MissileColor">#FF6400</Color>

    <Color x:Key="AlertGreen">#00B400</Color>
    <Color x:Key="AlertYellow">#FFC800</Color>
    <Color x:Key="AlertOrange">#FF8200</Color>
    <Color x:Key="AlertRed">#FF0000</Color>
    <Color x:Key="AlertBlack">#640000</Color>

    <Color x:Key="TextPrimary">#00DC00</Color>
    <Color x:Key="TextSecondary">#009600</Color>
    <Color x:Key="TextHighlight">#00FF00</Color>
    <Color x:Key="TextWarning">#FFC800</Color>
    <Color x:Key="TextCritical">#FF0000</Color>
    <Color x:Key="TextDim">#005A00</Color>

    <Color x:Key="InputBg">#001E00</Color>
    <Color x:Key="ButtonNormal">#1E3C1E</Color>
    <Color x:Key="ButtonHover">#285028</Color>
    <Color x:Key="ButtonActive">#00B400</Color>
    <Color x:Key="ButtonDanger">#641414</Color>

    <!-- ══ BRUSHES ════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="ConsoleBgBrush" Color="{StaticResource ConsoleBg}"/>
    <SolidColorBrush x:Key="PanelBgBrush" Color="{StaticResource PanelBg}"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="{StaticResource PanelBorder}"/>
    <SolidColorBrush x:Key="PanelHeaderBrush" Color="{StaticResource PanelHeader}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextHighlightBrush" Color="{StaticResource TextHighlight}"/>
    <SolidColorBrush x:Key="TextWarningBrush" Color="{StaticResource TextWarning}"/>
    <SolidColorBrush x:Key="TextCriticalBrush" Color="{StaticResource TextCritical}"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDim}"/>
    <SolidColorBrush x:Key="HostileBrush" Color="{StaticResource Hostile}"/>
    <SolidColorBrush x:Key="FriendlyBrush" Color="{StaticResource Friendly}"/>
    <SolidColorBrush x:Key="UnknownBrush" Color="{StaticResource Unknown}"/>
    <SolidColorBrush x:Key="MissileBrush" Color="{StaticResource MissileColor}"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBg}"/>

    <!-- ══ FONTS ══════════════════════════════════════════════════════════ -->
    <FontFamily x:Key="MonoFont">
        /Resources/Fonts/#Share Tech Mono, Consolas, Courier New
    </FontFamily>
    <FontFamily x:Key="HUDFont">
        /Resources/Fonts/#Rajdhani, Segoe UI, Arial
    </FontFamily>

    <!-- ══ TEXT STYLES ════════════════════════════════════════════════════ -->
    <Style x:Key="PrimaryText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="HeaderText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextHighlightBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="CharacterSpacing" Value="150"/>
    </Style>
    <Style x:Key="SmallText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="10"/>
    </Style>
    <Style x:Key="WarningText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextWarningBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="CriticalText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextCriticalBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- ══ BUTTON STYLES ══════════════════════════════════════════════════ -->
    <Style x:Key="MilButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ButtonNormal}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#285028"/>
                            <Setter Property="BorderBrush" Value="#00C800"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#00B400"/>
                            <Setter Property="Foreground" Value="#0A0C0A"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EngageButton" TargetType="Button" BasedOn="{StaticResource MilButton}">
        <Setter Property="Background" Value="#3C0000"/>
        <Setter Property="BorderBrush" Value="#960000"/>
        <Setter Property="Foreground" Value="#FF6464"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#640000"/>
                <Setter Property="BorderBrush" Value="#FF0000"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#FF0000"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══ SCROLLBAR STYLES ══════════════════════════════════════════════ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="#0A0C0A"/>
        <Setter Property="Foreground" Value="#1E3C1E"/>
        <Setter Property="Width" Value="8"/>
    </Style>

    <!-- ══ TEXTBOX STYLES ════════════════════════════════════════════════ -->
    <Style x:Key="MilTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource InputBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextHighlightBrush}"/>
        <Setter Property="SelectionBrush" Value="#205020"/>
        <Setter Property="Padding" Value="4,3"/>
    </Style>

    <!-- ══ PANEL CONTAINER STYLE ═════════════════════════════════════════ -->
    <Style x:Key="MilPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="2"/>
    </Style>

    <Style x:Key="PanelHeader" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelHeaderBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <!-- ══ SEPARATOR ══════════════════════════════════════════════════════ -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource PanelBorderBrush}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,4"/>
    </Style>

    <!-- ══ LISTVIEW STYLE ════════════════════════════════════════════════ -->
    <Style TargetType="ListView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style TargetType="ListViewItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="2,1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#0F200F"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#142814"/>
                <Setter Property="Foreground" Value="{StaticResource TextHighlightBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══ COMBOBOX STYLE ════════════════════════════════════════════════ -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource InputBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- ══ SLIDER STYLE ══════════════════════════════════════════════════ -->
    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══ COLORS ════════════════════════════════════════════════════════ -->
    <Color x:Key="ConsoleBg">#071019</Color>
    <Color x:Key="PanelBg">#0D1720</Color>
    <Color x:Key="PanelBorder">#22384A</Color>
    <Color x:Key="PanelHeader">#10212D</Color>

    <Color x:Key="RadarBg">#050F05</Color>
    <Color x:Key="RadarSweep">#00FF00</Color>
    <Color x:Key="RadarGrid">#005000</Color>
    <Color x:Key="RadarText">#00C800</Color>

    <Color x:Key="Hostile">#FF6B57</Color>
    <Color x:Key="Friendly">#67B4FF</Color>
    <Color x:Key="Unknown">#F4C14A</Color>
    <Color x:Key="Neutral">#85D68A</Color>
    <Color x:Key="MissileColor">#FF6400</Color>

    <Color x:Key="AlertGreen">#74C26E</Color>
    <Color x:Key="AlertYellow">#F0BD4D</Color>
    <Color x:Key="AlertOrange">#FF9852</Color>
    <Color x:Key="AlertRed">#FF6B57</Color>
    <Color x:Key="AlertBlack">#6A1E1E</Color>
    <Color x:Key="CardAccentBlue">#5AA8FF</Color>
    <Color x:Key="CardAccentGreen">#74C26E</Color>
    <Color x:Key="CardAccentAmber">#F0BD4D</Color>
    <Color x:Key="CardAccentRed">#FF6B57</Color>

    <Color x:Key="TextPrimary">#D8E5EC</Color>
    <Color x:Key="TextSecondary">#94A9B8</Color>
    <Color x:Key="TextHighlight">#F3F7FB</Color>
    <Color x:Key="TextWarning">#F0BD4D</Color>
    <Color x:Key="TextCritical">#FF6B57</Color>
    <Color x:Key="TextInfo">#7CB8FF</Color>
    <Color x:Key="TextAccent">#8ED28E</Color>
    <Color x:Key="TextDim">#536879</Color>

    <Color x:Key="InputBg">#09131A</Color>
    <Color x:Key="ButtonNormal">#162736</Color>
    <Color x:Key="ButtonHover">#214055</Color>
    <Color x:Key="ButtonActive">#79C3FF</Color>
    <Color x:Key="ButtonDanger">#5A1C1C</Color>

    <!-- ══ BRUSHES ════════════════════════════════════════════════════════ -->
    <LinearGradientBrush x:Key="ConsoleBgBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#06101A" Offset="0"/>
        <GradientStop Color="#0A141E" Offset="0.55"/>
        <GradientStop Color="#05090E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PanelBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#111A22" Offset="0"/>
        <GradientStop Color="#0C141B" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="{StaticResource PanelBorder}"/>
    <SolidColorBrush x:Key="PanelHeaderBrush" Color="{StaticResource PanelHeader}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextHighlightBrush" Color="{StaticResource TextHighlight}"/>
    <SolidColorBrush x:Key="TextWarningBrush" Color="{StaticResource TextWarning}"/>
    <SolidColorBrush x:Key="TextCriticalBrush" Color="{StaticResource TextCritical}"/>
    <SolidColorBrush x:Key="TextInfoBrush" Color="{StaticResource TextInfo}"/>
    <SolidColorBrush x:Key="TextAccentBrush" Color="{StaticResource TextAccent}"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDim}"/>
    <SolidColorBrush x:Key="CardAccentBlueBrush" Color="{StaticResource CardAccentBlue}"/>
    <SolidColorBrush x:Key="CardAccentGreenBrush" Color="{StaticResource CardAccentGreen}"/>
    <SolidColorBrush x:Key="CardAccentAmberBrush" Color="{StaticResource CardAccentAmber}"/>
    <SolidColorBrush x:Key="CardAccentRedBrush" Color="{StaticResource CardAccentRed}"/>
    <SolidColorBrush x:Key="HostileBrush" Color="{StaticResource Hostile}"/>
    <SolidColorBrush x:Key="FriendlyBrush" Color="{StaticResource Friendly}"/>
    <SolidColorBrush x:Key="UnknownBrush" Color="{StaticResource Unknown}"/>
    <SolidColorBrush x:Key="MissileBrush" Color="{StaticResource MissileColor}"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBg}"/>
    <SolidColorBrush x:Key="ButtonNormalBrush" Color="{StaticResource ButtonNormal}"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource ButtonHover}"/>
    <SolidColorBrush x:Key="ButtonActiveBrush" Color="{StaticResource ButtonActive}"/>
    <SolidColorBrush x:Key="ButtonDangerBrush" Color="{StaticResource ButtonDanger}"/>

    <!-- ══ FONTS ══════════════════════════════════════════════════════════ -->
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="HUDFont">Bahnschrift, Segoe UI</FontFamily>

    <!-- ══ TEXT STYLES ════════════════════════════════════════════════════ -->
    <Style x:Key="PrimaryText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource HUDFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="HeaderText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextHighlightBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource HUDFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="SectionKicker" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextInfoBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="SmallText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style x:Key="SubtleText" TargetType="TextBlock" BasedOn="{StaticResource SmallText}">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
    </Style>
    <Style x:Key="WarningText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextWarningBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource HUDFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="InfoText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextInfoBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style x:Key="AccentText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextAccentBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource HUDFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="CriticalText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextCriticalBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource HUDFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="StatusBadgeText" TargetType="TextBlock" BasedOn="{StaticResource SmallText}">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="MetricValueText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextHighlightBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource HUDFont}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="MetricLabelText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ══ BUTTON STYLES ══════════════════════════════════════════════════ -->
    <Style x:Key="MilButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ButtonNormalBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource HUDFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#214055"/>
                            <Setter Property="BorderBrush" Value="#69A7CF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#79C3FF"/>
                            <Setter Property="Foreground" Value="#081018"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#121B23"/>
                            <Setter Property="BorderBrush" Value="#1E2C38"/>
                            <Setter Property="Foreground" Value="#506273"/>
                            <Setter Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EngageButton" TargetType="Button" BasedOn="{StaticResource MilButton}">
        <Setter Property="Background" Value="#3C0000"/>
        <Setter Property="BorderBrush" Value="#960000"/>
        <Setter Property="Foreground" Value="#FF6464"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#640000"/>
                <Setter Property="BorderBrush" Value="#FF0000"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#FF0000"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══ SCROLLBAR STYLES ══════════════════════════════════════════════ -->
    <Style x:Key="ThinScrollThumb" TargetType="Thumb">
        <Setter Property="Background" Value="#334B5D"/>
        <Setter Property="BorderBrush" Value="#50697B"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Opacity" Value="0.45"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.75"/>
                <Setter Property="Background" Value="#4A6B82"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter Property="Opacity" Value="0.9"/>
                <Setter Property="Background" Value="#6D93AF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ThinScrollBarButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Width="6" Background="Transparent" Margin="0,2,0,2">
            <Border Background="#12000000" CornerRadius="3"/>
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ThinScrollBarButton}" Command="ScrollBar.LineUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ThinScrollThumb}" Margin="1,0"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ThinScrollBarButton}" Command="ScrollBar.LineDownCommand"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Height="6" Background="Transparent" Margin="2,0,2,0">
            <Border Background="#12000000" CornerRadius="3"/>
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ThinScrollBarButton}" Command="ScrollBar.LineLeftCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ThinScrollThumb}" Margin="0,1"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ThinScrollBarButton}" Command="ScrollBar.LineRightCommand"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#334B5D"/>
        <Setter Property="Width" Value="6"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══ TEXTBOX STYLES ════════════════════════════════════════════════ -->
    <Style x:Key="MilTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource InputBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextHighlightBrush}"/>
        <Setter Property="SelectionBrush" Value="#205020"/>
        <Setter Property="Padding" Value="4,3"/>
    </Style>

    <!-- ══ PANEL CONTAINER STYLE ═════════════════════════════════════════ -->
    <Style x:Key="MilPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style x:Key="MilInsetCard" TargetType="Border">
        <Setter Property="Background" Value="#0B1319"/>
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style x:Key="MilAccentCard" TargetType="Border" BasedOn="{StaticResource MilInsetCard}">
        <Setter Property="Background" Value="#101B23"/>
    </Style>
    <Style x:Key="MilMetricCard" TargetType="Border" BasedOn="{StaticResource MilInsetCard}">
        <Setter Property="Padding" Value="10,10"/>
    </Style>

    <Style x:Key="PanelHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelHeaderBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style x:Key="StatusBadge" TargetType="Border">
        <Setter Property="Background" Value="#101A22"/>
        <Setter Property="BorderBrush" Value="#284255"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
    </Style>
    <Style x:Key="ChipBorder" TargetType="Border" BasedOn="{StaticResource StatusBadge}">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="Margin" Value="0,0,6,4"/>
    </Style>
    <Style x:Key="ChipText" TargetType="TextBlock" BasedOn="{StaticResource SmallText}">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- ══ SEPARATOR ══════════════════════════════════════════════════════ -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource PanelBorderBrush}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,4"/>
    </Style>

    <!-- ══ LISTVIEW STYLE ════════════════════════════════════════════════ -->
    <Style TargetType="ListView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style TargetType="ListViewItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="4,3"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#15222C"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#1C2D3A"/>
                <Setter Property="Foreground" Value="{StaticResource TextHighlightBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══ COMBOBOX STYLE ════════════════════════════════════════════════ -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource InputBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- ══ SLIDER STYLE ══════════════════════════════════════════════════ -->
    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource CardAccentBlueBrush}"/>
        <Setter Property="Background" Value="#15202A"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            BorderBrush="#233544"
                            BorderThickness="1"
                            Height="{TemplateBinding Height}">
                        <Grid x:Name="PART_Track">
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3"
                                    Margin="1"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="PART_Indicator" Property="VerticalAlignment" Value="Bottom"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource HUDFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box"
                                Width="14"
                                Height="14"
                                CornerRadius="3"
                                VerticalAlignment="Center"
                                Background="#0A1319"
                                BorderBrush="#3D5B72"
                                BorderThickness="1"/>
                        <Path x:Name="Check"
                              Grid.Column="0"
                              Margin="3,4,0,0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Stroke="{StaticResource CardAccentGreenBrush}"
                              StrokeThickness="2"
                              Data="M 0 3 L 3 6 L 8 0"
                              Visibility="Collapsed"/>
                        <ContentPresenter Grid.Column="1"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="#13241A"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource CardAccentGreenBrush}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource CardAccentBlueBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid ClipToBounds="True" KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TabPanel Grid.Row="0"
                                  IsItemsHost="True"
                                  Margin="0,0,0,8"
                                  Background="Transparent"/>
                        <Border Grid.Row="1"
                                Background="#101711"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="0">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              Margin="0"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource PanelHeaderBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            Margin="0,0,6,0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          ContentSource="Header"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#1B2C39"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="#5A87A5"/>
                            <Setter Property="Foreground" Value="{StaticResource TextHighlightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#213544"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#101711"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

</ResourceDictionary>

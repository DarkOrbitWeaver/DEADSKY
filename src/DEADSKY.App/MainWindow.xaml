<Window x:Class="DEADSKY.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:DEADSKY.App.Controls"
        xmlns:comms="clr-namespace:DEADSKY.Core.Comms;assembly=DEADSKY.Core"
        mc:Ignorable="d"
        Title="DEADSKY Command Console"
        Height="980"
        Width="1640"
        Background="{StaticResource ConsoleBgBrush}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.32*"/>
                <ColumnDefinition Width="0.78*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource MilPanel}" Padding="10,6">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Button Content="{Binding MenuButtonText}"
                                Style="{StaticResource MilButton}"
                                Command="{Binding ToggleCommandMenuCommand}"
                                Margin="0,0,12,0"/>
                        <TextBlock Text="DEADSKY // AIR DEFENSE STATION"
                                   Style="{StaticResource HeaderText}"
                                   VerticalAlignment="Center" />
                        <Border Style="{StaticResource StatusBadge}" Margin="12,0,0,0">
                            <TextBlock Text="{Binding OperationModeText}" Style="{StaticResource StatusBadgeText}" />
                        </Border>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Right" LastChildFill="False" VerticalAlignment="Center">
                        <Button Content="TACTICAL MAP"
                                Style="{StaticResource MilButton}"
                                Click="OnOpenTacticalMap"
                                Margin="0,0,10,0"/>
                        <Border Style="{StaticResource StatusBadge}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding FireControlHeadlineText}" Style="{StaticResource StatusBadgeText}" />
                        </Border>
                        <Border Style="{StaticResource StatusBadge}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding AlertLevelText, StringFormat=ALERT {0}}" Style="{StaticResource StatusBadgeText}" />
                        </Border>
                        <Border Style="{StaticResource StatusBadge}">
                            <TextBlock Text="{Binding GameTime}" Style="{StaticResource StatusBadgeText}" />
                        </Border>
                    </DockPanel>
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource WarningText}"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding StatusMessage}" />
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource MilPanel}" Margin="0,12,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="TACTICAL SCOPE" Style="{StaticResource HeaderText}" />
                            <Button DockPanel.Dock="Right"
                                    Content="OPEN MAP"
                                    Style="{StaticResource MilButton}"
                                    Click="OnOpenTacticalMap"/>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding RadarCursorReadout}"
                                       Style="{StaticResource SmallText}"
                                       Margin="12,0,12,0"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="292"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="#041008"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <controls:RadarDisplay x:Name="RadarScope"
                                                   Margin="8"
                                                   Snapshot="{Binding CurrentSnapshot}"
                                                   FriendlyForces="{Binding VisibleFriendlyForces}"
                                                   ShowAltitudeLabels="{Binding ShowRadarAltitudeLabels}"
                                                   ShowTrackTrails="{Binding ShowRadarTrackTrails}"
                                                   SelectedTrackId="{Binding SelectedTrackId, Mode=TwoWay}"/>
                        </Border>
                        <ScrollViewer Grid.Column="1"
                                      Margin="12,0,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Style="{StaticResource MilPanel}" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="SCOPE CONTROL" Style="{StaticResource HeaderText}" />
                                        <TextBlock Text="{Binding RadarRangeStatusText}" Style="{StaticResource AccentText}" Margin="0,6,0,0" />
                                        <UniformGrid Rows="2" Columns="2" Margin="0,8,0,0">
                                            <Button Content="SEARCH" Style="{StaticResource MilButton}" Command="{Binding SetRadarSearchCommand}" ToolTip="Wide-area search sweep for initial detection." />
                                            <Button Content="TWS" Style="{StaticResource MilButton}" Command="{Binding SetRadarTWSCommand}" Margin="6,0,0,0" ToolTip="Track-while-scan to hold track files while sweeping." />
                                            <Button Content="SILENT" Style="{StaticResource MilButton}" Command="{Binding SetRadarSilentCommand}" Margin="0,6,0,0" ToolTip="Emission silence for reduced signature." />
                                            <Button Content="STBY" Style="{StaticResource MilButton}" Command="{Binding SetRadarStandbyCommand}" Margin="6,6,0,0" ToolTip="Radar standby with power still available." />
                                        </UniformGrid>
                                        <UniformGrid Rows="1" Columns="3" Margin="0,8,0,0">
                                            <Button Content="40" Style="{StaticResource MilButton}" Command="{Binding SetRadarRangePresetCommand}" CommandParameter="40" ToolTip="Tight tactical scan for close work." />
                                            <Button Content="80" Style="{StaticResource MilButton}" Command="{Binding SetRadarRangePresetCommand}" CommandParameter="80" Margin="6,0,0,0" ToolTip="Balanced sector scan." />
                                            <Button Content="120" Style="{StaticResource MilButton}" Command="{Binding SetRadarRangePresetCommand}" CommandParameter="120" Margin="6,0,0,0" ToolTip="Long-range early warning watch." />
                                        </UniformGrid>
                                        <TextBlock Text="{Binding RadarModeText}" Style="{StaticResource PrimaryText}" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding TrackHoldStatusText}" Style="{StaticResource SmallText}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding RadarEmissionText}" Style="{StaticResource SmallText}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding RadarSweepText}" Style="{StaticResource SubtleText}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MilPanel}" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="FIRE CONTROL" Style="{StaticResource HeaderText}" />
                                        <TextBlock Text="{Binding FireControlHeadlineText}" Style="{StaticResource WarningText}" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding FireControlSummaryText}" Style="{StaticResource AccentText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding FireControlDetailText}" Style="{StaticResource SmallText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding FireControlSupportText}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MilPanel}" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="LOADOUT MANAGEMENT" Style="{StaticResource SectionKicker}" />
                                        <TextBlock Text="WEAPONS / LOADOUT" Style="{StaticResource HeaderText}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding WeaponLoadoutSummaryText}" Style="{StaticResource PrimaryText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Border Style="{StaticResource ChipBorder}" Background="#112231" BorderBrush="{StaticResource CardAccentBlueBrush}">
                                                <TextBlock Text="{Binding SelectedWeaponGuidanceText}" Style="{StaticResource ChipText}" />
                                            </Border>
                                            <Border Style="{StaticResource ChipBorder}" Background="#182114" BorderBrush="{StaticResource CardAccentGreenBrush}">
                                                <TextBlock Text="{Binding SelectedWeaponPkText}" Style="{StaticResource ChipText}" />
                                            </Border>
                                            <Border Style="{StaticResource ChipBorder}" Background="#2A1B10" BorderBrush="{StaticResource CardAccentAmberBrush}">
                                                <TextBlock Text="{Binding SelectedWeaponReadinessText}" Style="{StaticResource ChipText}" />
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding SelectedWeaponEnvelopeText}" Style="{StaticResource SmallText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedWeaponSupportText}" Style="{StaticResource SmallText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedWeaponCountermeasureText}" Style="{StaticResource SmallText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding WeaponRecommendationText}" Style="{StaticResource AccentText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding WeaponActionStatusText}" Style="{StaticResource SmallText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding FriendlyFireRiskText}" Style="{StaticResource WarningText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedWeaponDescriptionText}" Style="{StaticResource SubtleText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding WeaponOptions}" Margin="0,10,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="WeaponCard"
                                                            Style="{StaticResource MilInsetCard}"
                                                            Margin="0,0,0,6"
                                                            ToolTip="{Binding Tooltip}">
                                                        <StackPanel>
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource PrimaryText}" />
                                                                <Border DockPanel.Dock="Right"
                                                                        Style="{StaticResource ChipBorder}"
                                                                        Background="#132231"
                                                                        BorderBrush="{StaticResource CardAccentBlueBrush}"
                                                                        Margin="8,0,0,0">
                                                                    <TextBlock Text="{Binding RangeLabel}" Style="{StaticResource ChipText}" />
                                                                </Border>
                                                            </DockPanel>
                                                            <WrapPanel Margin="0,6,0,0">
                                                                <Border Style="{StaticResource ChipBorder}" Background="#152317" BorderBrush="{StaticResource CardAccentGreenBrush}">
                                                                    <TextBlock Text="{Binding GuidanceLabel}" Style="{StaticResource ChipText}" />
                                                                </Border>
                                                                <Border Style="{StaticResource ChipBorder}" Background="#221A10" BorderBrush="{StaticResource CardAccentAmberBrush}">
                                                                    <TextBlock Text="{Binding SupportLabel}" Style="{StaticResource ChipText}" />
                                                                </Border>
                                                                <Border Style="{StaticResource ChipBorder}" Background="#141A21" BorderBrush="{StaticResource PanelBorderBrush}">
                                                                    <TextBlock Text="{Binding PkLabel}" Style="{StaticResource ChipText}" />
                                                                </Border>
                                                            </WrapPanel>
                                                            <TextBlock Text="{Binding EnvelopeLabel}" Style="{StaticResource SmallText}" Margin="0,4,0,0" />
                                                            <TextBlock Text="{Binding CountermeasureLabel}" Style="{StaticResource SmallText}" Margin="0,2,0,0" />
                                                            <TextBlock Text="{Binding Description}" Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                            <Button Content="{Binding SelectLabel}"
                                                                    Style="{StaticResource MilButton}"
                                                                    Margin="0,8,0,0"
                                                                    Command="{Binding DataContext.SelectWeaponCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Id}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="WeaponCard" Property="BorderBrush" Value="{StaticResource CardAccentBlueBrush}" />
                                                            <Setter TargetName="WeaponCard" Property="Background" Value="#102131" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Style="{StaticResource MilInsetCard}" Margin="0,10,0,0" BorderBrush="{StaticResource CardAccentAmberBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding AbortAvailabilityText}" Style="{StaticResource WarningText}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding RecentIncidentSummaryText}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Button Content="ABORT ENGAGEMENT"
                                                Style="{StaticResource MilButton}"
                                                Command="{Binding AbortSelectedTrackCommand}"
                                                Margin="0,8,0,0"
                                                ToolTip="Abort supported missiles already in flight against the selected track when the weapon allows it." />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MilPanel}" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="ENGAGEMENT CONTROL" Style="{StaticResource SectionKicker}" />
                                        <TextBlock Text="{Binding SelectedTrackPanelTitle}" Style="{StaticResource HeaderText}" />
                                        <TextBlock Text="{Binding SelectedTrackThreatText}" Style="{StaticResource WarningText}" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding TrackSelectionPromptText}"
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   FontSize="12"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSelectedTrack}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Visibility="{Binding HasSelectedTrack, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <WrapPanel Margin="0,6,0,0">
                                            <Border Style="{StaticResource ChipBorder}" Background="#132231" BorderBrush="{StaticResource CardAccentBlueBrush}">
                                                <TextBlock Text="{Binding SelectedTrackBraa}" Style="{StaticResource ChipText}" />
                                            </Border>
                                            <Border Style="{StaticResource ChipBorder}" Background="#20140F" BorderBrush="{StaticResource CardAccentAmberBrush}">
                                                <TextBlock Text="{Binding SelectedTrackTimeToThreatText}" Style="{StaticResource ChipText}" />
                                            </Border>
                                            <Border Style="{StaticResource ChipBorder}" Background="#182114" BorderBrush="{StaticResource CardAccentGreenBrush}">
                                                <TextBlock Text="{Binding SelectedTrackEnvelopeText}" Style="{StaticResource ChipText}" />
                                            </Border>
                                        </WrapPanel>
                                        <Border Style="{StaticResource MilInsetCard}" Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding SelectedTrackIdentityText}" Style="{StaticResource SmallText}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SelectedTrackMissionText}" Style="{StaticResource SmallText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SelectedTrackStatusText}" Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding SelectedTrackControlText}" Style="{StaticResource AccentText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding SelectedTrackKinematicsText}" Style="{StaticResource AccentText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding SelectedTrackDoctrineText}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MilInsetCard}" Margin="0,8,0,0" BorderBrush="{StaticResource CardAccentBlueBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding OperationalPictureText}" Style="{StaticResource SmallText}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding VisibleFriendlyForceText}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="DESIGNATE" Style="{StaticResource MilButton}" Command="{Binding DesignateSelectedCommand}" ToolTip="Set the selected track as the fire-control reference." />
                                            <Button Content="{Binding TrackHoldButtonText}" Style="{StaticResource MilButton}" Command="{Binding ToggleTrackHoldSelectedCommand}" Margin="6,0,0,0" ToolTip="Keep this contact in TWS memory so you can sort multiple targets." />
                                            <Button Content="RELEASE" Style="{StaticResource MilButton}" Command="{Binding ReleaseSelectedTrackCommand}" Margin="6,0,0,0" ToolTip="Drop the current track hold or hard lock." />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,6,0,0">
                                            <Button Content="FIRE 1" Style="{StaticResource EngageButton}" Command="{Binding FireSingleCommand}" ToolTip="Commit a single missile against the selected track." />
                                            <Button Content="SALVO x2" Style="{StaticResource EngageButton}" Command="{Binding FireSalvoCommand}" Margin="6,0,0,0" ToolTip="Fire two missiles quickly at the same target for a higher kill chance." />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding EngagementActionHintText}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding LauncherStates}" Margin="0,10,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource MilInsetCard}" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="42"/>
                                                                <ColumnDefinition Width="70"/>
                                                                <ColumnDefinition Width="54"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding LauncherId}" Style="{StaticResource PrimaryText}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding StateText}" Style="{StaticResource SmallText}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding MissileType}" Style="{StaticResource AccentText}"/>
                                                            <ProgressBar Grid.Column="3" Minimum="0" Maximum="1" Value="{Binding ReloadProgress}" Height="10" Margin="8,4,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Grid.Column="1" Margin="0,12,60,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource MilPanel}" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="LIVE OPERATING PICTURE" Style="{StaticResource SectionKicker}"/>
                        <DockPanel LastChildFill="False" Margin="0,2,0,0">
                            <TextBlock Text="MISSION BOARD" Style="{StaticResource HeaderText}"/>
                            <Border DockPanel.Dock="Right"
                                    Style="{StaticResource ChipBorder}"
                                    Background="#2F2415"
                                    BorderBrush="{StaticResource CardAccentAmberBrush}">
                                <TextBlock Text="{Binding MissionPhaseText}" Style="{StaticResource ChipText}"/>
                            </Border>
                        </DockPanel>
                        <UniformGrid Rows="1" Columns="4" Margin="0,10,0,0">
                            <Border Style="{StaticResource MilMetricCard}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="ALERT" Style="{StaticResource MetricLabelText}"/>
                                    <TextBlock Text="{Binding AlertLevelText}" Style="{StaticResource MetricValueText}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding FireControlHeadlineText}" Style="{StaticResource SmallText}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MilMetricCard}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="READY" Style="{StaticResource MetricLabelText}"/>
                                    <TextBlock Text="{Binding ReadyLaunchers}" Style="{StaticResource MetricValueText}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding BatteryLaunchStatusText}" Style="{StaticResource SmallText}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MilMetricCard}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="MAGAZINE" Style="{StaticResource MetricLabelText}"/>
                                    <TextBlock Text="{Binding ReserveMissiles}" Style="{StaticResource MetricValueText}" Margin="0,4,0,0"/>
                                    <TextBlock Text="RESERVE MISSILES" Style="{StaticResource SmallText}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MilMetricCard}">
                                <StackPanel>
                                    <TextBlock Text="THREATS" Style="{StaticResource MetricLabelText}"/>
                                    <TextBlock Text="{Binding HostileCount}" Style="{StaticResource MetricValueText}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding ThreatSummaryText}" Style="{StaticResource SmallText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Style="{StaticResource MilAccentCard}" Margin="0,10,0,0" BorderBrush="{StaticResource CardAccentBlueBrush}">
                            <StackPanel>
                                <TextBlock Text="SECTOR POSTURE" Style="{StaticResource SectionKicker}"/>
                                <TextBlock Text="{Binding AirPictureText}" Style="{StaticResource PrimaryText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding RecommendationText}" Style="{StaticResource PrimaryText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding IncomingThreatText}" Style="{StaticResource CriticalText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding ObjectiveStatusText}" Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource MilInsetCard}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="SUPPORT PICTURE" Style="{StaticResource SectionKicker}"/>
                                    <TextBlock Text="{Binding SupportActivitySummaryText}" Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding VisibleSupportPictureText}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding WeatherSummary}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource MilInsetCard}" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding RecentIncidentHeadlineText}" Style="{StaticResource SectionKicker}"/>
                                    <TextBlock Text="{Binding RecentIncidentSummaryText}" Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <ItemsControl ItemsSource="{Binding RecentIncidentCards}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource MilInsetCard}" Margin="0,0,0,6" Padding="8,6">
                                                    <StackPanel>
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock Text="{Binding Title}" Style="{StaticResource AccentText}"/>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource SmallText}"/>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding SeverityLabel}" Style="{StaticResource WarningText}" Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource MilPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="TRACK BOARD" Style="{StaticResource HeaderText}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ThreatSummaryText}" Style="{StaticResource SmallText}"/>
                            </DockPanel>
                        </Border>
                        <ListView x:Name="ThreatList"
                                  Grid.Row="1"
                                  ItemsSource="{Binding ThreatBoardTracks}"
                                  SelectedValuePath="TrackId"
                                  SelectedValue="{Binding SelectedTrackId, Mode=TwoWay}"
                                  Margin="8"
                                  ScrollViewer.CanContentScroll="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,4"
                                            Padding="7,5"
                                            Background="#0B141B"
                                            BorderBrush="{Binding RowBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock Text="{Binding TrackId}" Style="{StaticResource SmallText}" Foreground="{Binding RowBrush}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Callout}" Style="{StaticResource SmallText}" Margin="8,0,0,0" Foreground="{Binding RowBrush}"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ThreatText}" Style="{StaticResource WarningText}" />
                                            </DockPanel>
                                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource SmallText}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Bearing}"/>
                                                    <Run Text="/"/>
                                                    <Run Text="{Binding RangeText}"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{Binding AltitudeText}"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{Binding Aspect}"/>
                                                    <Run Text=" | "/>
                                                    <Run Text="{Binding StateDisplay}"/>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Text="{Binding PackageLabel}" Style="{StaticResource SubtleText}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.ColumnSpan="2"
                    Width="{Binding CommsDrawerWidth}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Margin="0,60,6,0"
                    Panel.ZIndex="24"
                    Background="#F00C141B"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="#0E141B"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="0,0,1,0">
                        <Grid Margin="4,8">
                            <Button Content="{Binding CommsDrawerToggleText}"
                                    Style="{StaticResource MilButton}"
                                    Padding="6,4"
                                    Width="32"
                                    Height="28"
                                    VerticalAlignment="Top"
                                    Command="{Binding ToggleCommsDrawerCommand}"/>
                            <Border Background="#233545"
                                    BorderBrush="#7CB8FF"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="4,1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,-4,-4,0"
                                    Visibility="{Binding HasUnreadComms, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding CommsUnreadBadgeText}"
                                           Style="{StaticResource SmallText}"
                                           Foreground="{StaticResource TextHighlightBrush}"
                                           FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1"
                          Visibility="{Binding IsCommsDrawerOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="COMMS WINDOW" Style="{StaticResource HeaderText}" />
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding ActiveChannel, StringFormat=NET {0}}"
                                           Style="{StaticResource SmallText}" />
                            </DockPanel>
                        </Border>
                        <TabControl x:Name="CommsTabs" Grid.Row="1" Margin="6">
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Radio" />
                                        <Border Background="#233545"
                                                BorderBrush="#7CB8FF"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="4,0"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding DataContext.HasUnreadRadioTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding DataContext.RadioUnreadBadgeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Style="{StaticResource SmallText}"
                                                       Foreground="{StaticResource TextHighlightBrush}"
                                                       FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </TabItem.Header>
                                <Grid Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="44"/>
                                    </Grid.RowDefinitions>
                                    <UniformGrid Grid.Row="0" Rows="1" Columns="6" Margin="0,0,0,6">
                                        <Button Content="{Binding CommandChannelLabel}" Style="{StaticResource MilButton}" Command="{Binding SelectChannelCommand}" CommandParameter="{x:Static comms:RadioChannel.CommandNet}" />
                                        <Button Content="{Binding BatteryChannelLabel}" Style="{StaticResource MilButton}" Margin="4,0,0,0" Command="{Binding SelectChannelCommand}" CommandParameter="{x:Static comms:RadioChannel.BatteryNet}" />
                                        <Button Content="{Binding AirDefenseChannelLabel}" Style="{StaticResource MilButton}" Margin="4,0,0,0" Command="{Binding SelectChannelCommand}" CommandParameter="{x:Static comms:RadioChannel.AirDefenseNet}" />
                                        <Button Content="{Binding IntelChannelLabel}" Style="{StaticResource MilButton}" Margin="4,0,0,0" Command="{Binding SelectChannelCommand}" CommandParameter="{x:Static comms:RadioChannel.IntelNet}" />
                                        <Button Content="{Binding GuardChannelLabel}" Style="{StaticResource MilButton}" Margin="4,0,0,0" Command="{Binding SelectChannelCommand}" CommandParameter="{x:Static comms:RadioChannel.Guard}" />
                                        <Button Content="{Binding OpenChannelLabel}" Style="{StaticResource MilButton}" Margin="4,0,0,0" Command="{Binding SelectChannelCommand}" CommandParameter="{x:Static comms:RadioChannel.OpenFreq}" />
                                    </UniformGrid>
                                    <ListView x:Name="CommsList"
                                              Grid.Row="1"
                                              ItemsSource="{Binding CurrentChannelMessages}"
                                              SelectedItem="{Binding SelectedMessage, Mode=TwoWay}"
                                              HorizontalContentAlignment="Stretch"
                                              ScrollViewer.CanContentScroll="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Bubble"
                                                        HorizontalAlignment="Stretch"
                                                        Padding="8,6"
                                                        Background="#0E171E"
                                                        BorderBrush="{Binding HeaderColorHex}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Margin="0,0,0,6"
                                                        ToolTip="{Binding DisplayHeader}">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding CompactDisplayHeader}" Style="{StaticResource PrimaryText}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding FormattedTime}" Style="{StaticResource SmallText}" />
                                                        </Grid>
                                                        <Grid Margin="0,2,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding SenderDescriptor}" Style="{StaticResource SubtleText}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding PriorityTag}" Style="{StaticResource SubtleText}" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding Content}"
                                                                   Foreground="{Binding BodyColorHex}"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,5,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsFromPlayer}" Value="True">
                                                        <Setter TargetName="Bubble" Property="Background" Value="#132230" />
                                                        <Setter TargetName="Bubble" Property="BorderBrush" Value="#4D8EC0" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <StackPanel Grid.Row="2" Margin="0,6,0,6">
                                        <TextBlock Text="{Binding PlayerIdentityText}" Style="{StaticResource SubtleText}" />
                                        <TextBlock Text="{Binding ActiveChannelRouteText}"
                                                   Style="{StaticResource AccentText}"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap"
                                                   ToolTip="{Binding ActiveChannelEffectText}" />
                                        <WrapPanel Margin="0,6,0,0">
                                            <Button Content="ACK" Style="{StaticResource MilButton}" Command="{Binding SendQuickCommandCommand}" CommandParameter="ack" ToolTip="Send a quick acknowledgment on the active net." />
                                            <Button Content="PICTURE" Style="{StaticResource MilButton}" Margin="4,0,0,0" Command="{Binding SendQuickCommandCommand}" CommandParameter="picture" ToolTip="Request a refreshed air picture." />
                                            <Button Content="DECLARE" Style="{StaticResource MilButton}" Margin="4,0,0,0" Command="{Binding SendQuickCommandCommand}" CommandParameter="declare" ToolTip="Request declare on the selected track." />
                                            <Button Content="HOLD" Style="{StaticResource MilButton}" Margin="4,0,0,0" Command="{Binding SendHoldFireReplyCommand}" ToolTip="Reply with hold-fire guidance." />
                                            <Button Content="WARN" Style="{StaticResource MilButton}" Margin="4,0,0,0" Command="{Binding SendWarningReplyCommand}" ToolTip="Issue an immediate turn-away warning." />
                                            <Button Content="STATUS" Style="{StaticResource MilButton}" Margin="4,0,0,0" Command="{Binding SendQuickCommandCommand}" CommandParameter="status" ToolTip="Transmit a battery status report." />
                                            <Button Content="REPEAT" Style="{StaticResource MilButton}" Margin="4,0,0,0" Command="{Binding SendRepeatReplyCommand}" ToolTip="Request a repeated transmission." />
                                        </WrapPanel>
                                    </StackPanel>
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="88"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="MessageInput"
                                                 Grid.Column="0"
                                                 Style="{StaticResource MilTextBox}"
                                                 ToolTip="{Binding ActiveChannelEffectText}"
                                                 Text="{Binding InputMessage, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="1"
                                                Content="SEND"
                                                Style="{StaticResource MilButton}"
                                                Margin="8,0,0,0"
                                                Command="{Binding SendMessageCommand}"/>
                                    </Grid>
                                </Grid>
                            </TabItem>
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Alerts" />
                                        <Border Background="#3A2716"
                                                BorderBrush="#F0BD4D"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="4,0"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding DataContext.HasUnreadAlertsTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding DataContext.AlertsUnreadBadgeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Style="{StaticResource SmallText}"
                                                       Foreground="{StaticResource TextHighlightBrush}"
                                                       FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </TabItem.Header>
                                <Grid Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <ItemsControl Grid.Row="0" ItemsSource="{Binding ActiveNotifications}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding BackgroundHex}"
                                                        BorderBrush="{Binding AccentHex}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="8,6"
                                                        Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock Text="{Binding Title}" Foreground="{Binding AccentHex}" FontFamily="{StaticResource HUDFont}" FontSize="12" FontWeight="Bold" />
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource SmallText}" />
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding SourceTag}" Style="{StaticResource SubtleText}" Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding Body}" Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ListView Grid.Row="1"
                                              ItemsSource="{Binding PriorityOverlayMessages}"
                                              Margin="0,8,0,0"
                                              ScrollViewer.CanContentScroll="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#10171D"
                                                        BorderBrush="{Binding HeaderColorHex}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="8,6"
                                                        Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock Text="{Binding CompactDisplayHeader}" Style="{StaticResource PrimaryText}" />
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding FormattedTime}" Style="{StaticResource SmallText}" />
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Content}"
                                                                   Foreground="{Binding BodyColorHex}"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,6,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </TabItem>
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Log" />
                                        <Border Background="#223140"
                                                BorderBrush="#7CB8FF"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="4,0"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding DataContext.HasUnreadLogTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding DataContext.LogUnreadBadgeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Style="{StaticResource SmallText}"
                                                       Foreground="{StaticResource TextHighlightBrush}"
                                                       FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </TabItem.Header>
                                <ListView ItemsSource="{Binding OpsFeed}"
                                          Margin="8"
                                          ScrollViewer.CanContentScroll="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0E171E"
                                                    BorderBrush="{StaticResource PanelBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="8,6"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="64"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource SmallText}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Category}" Style="{StaticResource AccentText}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Message}" Style="{StaticResource SmallText}" TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Visibility="{Binding IsCommandMenuOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Width="520"
                    Margin="12"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Background="#48101820"
                    CornerRadius="8"
                    IsHitTestVisible="False"/>
            <Border Width="470"
                    Margin="24"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Style="{StaticResource MilPanel}"
                    IsHitTestVisible="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="OPS MENU" Style="{StaticResource HeaderText}" />
                            <Button DockPanel.Dock="Right"
                                    Content="CLOSE"
                                    Style="{StaticResource MilButton}"
                                    Command="{Binding CloseCommandMenuCommand}"/>
                        </DockPanel>
                    </Border>
                    <TabControl Grid.Row="1" Margin="10">
                        <TabItem Header="Mission">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="MISSION CONTROL" Style="{StaticResource HeaderText}"/>
                                    <TextBlock Text="{Binding MissionName}" Style="{StaticResource PrimaryText}" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding MissionPhaseText}" Style="{StaticResource WarningText}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding CurrentScenarioArchetypeText}" Style="{StaticResource AccentText}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding ObjectiveStatusText}" Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding RecommendationText}" Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding MissionPauseHintText}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="LOAD TUTORIAL" Style="{StaticResource MilButton}" Command="{Binding LoadScenarioCommand}" CommandParameter="tutorial" ToolTip="Load the short demo scenario."/>
                                        <Button Content="LOAD STARTUP OP" Style="{StaticResource MilButton}" Command="{Binding LoadScenarioCommand}" CommandParameter="startup" Margin="6,0,0,0" ToolTip="Load a varied scripted operation from the live rotation."/>
                                        <Button Content="LOAD DEADSKY" Style="{StaticResource MilButton}" Command="{Binding LoadScenarioCommand}" CommandParameter="operation" Margin="6,0,0,0" ToolTip="Load the larger multi-axis scripted operation."/>
                                        <Button Content="GENERATE SHIFT" Style="{StaticResource MilButton}" Command="{Binding LoadRealisticModeCommand}" Margin="6,0,0,0" ToolTip="Generate a fresh live operation without exposing backend plumbing."/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding CurrentScenarioSaveTruthText}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="{Binding MissionPrimaryActionText}" Style="{StaticResource MilButton}" Command="{Binding StartMissionCommand}"/>
                                        <Button Content="PAUSE" Style="{StaticResource MilButton}" Command="{Binding PauseMissionCommand}" Margin="6,0,0,0"/>
                                        <Button Content="TACTICAL MAP" Style="{StaticResource MilButton}" Click="OnOpenTacticalMap" Margin="6,0,0,0"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding RealisticModeStatusText}" Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Shortcuts">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="STATION SHORTCUTS" Style="{StaticResource HeaderText}"/>
                                    <TextBlock Text="SPACE start or pause | TAB cycle tracks | D designate | H hold track | R release track" Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <TextBlock Text="F fire one | G salvo x2 | Q/W/E switch radar modes | 1/2/3 change range" Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="M open map | Mouse wheel on map zooms only the map | ` focus comms" Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="Use HOLD TRACK in TWS to sort multiple enemies, then DESIGNATE only when you want a hard lock." Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Settings">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="LIVE SETTINGS" Style="{StaticResource HeaderText}"/>
                                    <TextBlock Text="These are active gameplay/UI switches, not dead legacy placeholders." Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <CheckBox Content="Auto-focus scope range to selected track"
                                              IsChecked="{Binding AutoFocusSelectedTrack}"
                                              Margin="0,12,0,0"/>
                                    <CheckBox Content="Show altitude and speed labels on radar contacts"
                                              IsChecked="{Binding ShowRadarAltitudeLabels}"
                                              Margin="0,10,0,0"/>
                                    <CheckBox Content="Show radar track trails and held-track memory lines"
                                              IsChecked="{Binding ShowRadarTrackTrails}"
                                              Margin="0,10,0,0"/>
                                    <CheckBox Content="Show tactical map labels and sector notes"
                                              IsChecked="{Binding ShowTacticalMapLabels}"
                                              Margin="0,10,0,0"/>
                                    <TextBlock Text="Map zoom is independent from the radar scope range. Changing one will not disturb the other." Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Logistics">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="ARMORY / CAMPAIGN" Style="{StaticResource SectionKicker}"/>
                                    <TextBlock Text="CAMPAIGN &amp; LOGISTICS" Style="{StaticResource HeaderText}"/>
                                    <Border Style="{StaticResource MilAccentCard}" Margin="0,10,0,0" BorderBrush="{StaticResource CardAccentBlueBrush}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ArmoryHeadlineText}" Style="{StaticResource PrimaryText}"/>
                                            <TextBlock Text="{Binding LogisticsTempoText}" Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            <TextBlock Text="{Binding CampaignPersistenceSummaryText}" Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            <TextBlock Text="{Binding CampaignSavePathText}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            <WrapPanel Margin="0,10,0,0">
                                                <Button Content="SAVE PROFILE" Style="{StaticResource MilButton}" Command="{Binding SaveCampaignNowCommand}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <UniformGrid Rows="1" Columns="3" Margin="0,10,0,0">
                                        <Border Style="{StaticResource MilMetricCard}" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="BUDGET" Style="{StaticResource MetricLabelText}"/>
                                                <TextBlock Text="{Binding BudgetDisplayText}" Style="{StaticResource PrimaryText}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MilMetricCard}" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="RANK" Style="{StaticResource MetricLabelText}"/>
                                                <TextBlock Text="{Binding PlayerRankDisplayText}" Style="{StaticResource PrimaryText}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MilMetricCard}">
                                            <StackPanel>
                                                <TextBlock Text="CAREER" Style="{StaticResource MetricLabelText}"/>
                                                <TextBlock Text="{Binding CareerSummaryText}" Style="{StaticResource SmallText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                    <Border Style="{StaticResource MilInsetCard}" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding OwnedUpgradeSummaryText}" Style="{StaticResource SmallText}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding PendingDeliverySummaryText}" Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            <TextBlock Text="{Binding LogisticsStatusText}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            <TextBlock Text="{Binding StoreAvailabilityText}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding RequisitionOptions}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="ReqCard"
                                                        Style="{StaticResource MilInsetCard}"
                                                        Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                            <WrapPanel>
                                                                <Border Style="{StaticResource ChipBorder}" Background="#132231" BorderBrush="{StaticResource CardAccentBlueBrush}">
                                                                    <TextBlock Text="{Binding CategoryBadgeText}" Style="{StaticResource ChipText}"/>
                                                                </Border>
                                                                <Border Style="{StaticResource ChipBorder}" Background="#1A1F14" BorderBrush="{StaticResource CardAccentGreenBrush}">
                                                                    <TextBlock Text="{Binding AvailabilityText}" Style="{StaticResource ChipText}"/>
                                                                </Border>
                                                            </WrapPanel>
                                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource PrimaryText}" Margin="0,4,0,0"/>
                                                            <TextBlock Text="{Binding Description}" Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                            <TextBlock Text="{Binding ImpactText}" Style="{StaticResource AccentText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                            <WrapPanel Margin="0,6,0,0">
                                                                <Border Style="{StaticResource ChipBorder}" Background="#1B1510" BorderBrush="{StaticResource CardAccentAmberBrush}">
                                                                    <TextBlock Text="{Binding RequirementText}" Style="{StaticResource ChipText}"/>
                                                                </Border>
                                                                <Border Style="{StaticResource ChipBorder}" Background="#141A21" BorderBrush="{StaticResource PanelBorderBrush}">
                                                                    <TextBlock Text="{Binding LeadTimeText}" Style="{StaticResource ChipText}"/>
                                                                </Border>
                                                            </WrapPanel>
                                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource AccentText}" Margin="0,6,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding CostText}" Style="{StaticResource WarningText}" HorizontalAlignment="Right"/>
                                                            <Button Content="{Binding OrderActionText}"
                                                                    Style="{StaticResource MilButton}"
                                                                    Margin="0,8,0,0"
                                                                    Command="{Binding DataContext.PurchaseUpgradeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Id}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsOwned}" Value="True">
                                                        <Setter TargetName="ReqCard" Property="BorderBrush" Value="{StaticResource CardAccentGreenBrush}"/>
                                                        <Setter TargetName="ReqCard" Property="Background" Value="#102016"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                        <Setter TargetName="ReqCard" Property="BorderBrush" Value="{StaticResource CardAccentBlueBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsRankLocked}" Value="True">
                                                        <Setter TargetName="ReqCard" Property="BorderBrush" Value="{StaticResource CardAccentAmberBrush}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

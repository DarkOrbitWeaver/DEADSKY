<Window x:Class="DEADSKY.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:DEADSKY.App.Controls"
        xmlns:comms="clr-namespace:DEADSKY.Core.Comms;assembly=DEADSKY.Core"
        mc:Ignorable="d"
        Title="DEADSKY Command Console"
        Height="920"
        Width="1540"
        Background="{StaticResource ConsoleBgBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="230"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource MilPanel}" Padding="10,6">
            <DockPanel LastChildFill="False">
                <TextBlock Text="DEADSKY // KOVRAN THEATER" Style="{StaticResource HeaderText}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="TACTICAL MAP" Style="{StaticResource MilButton}" Click="OnOpenTacticalMap" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding AiStatusText, StringFormat=AI: {0}}" Style="{StaticResource HeaderText}" Foreground="{Binding AiStatusColor}"/>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource WarningText}" Margin="14,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource MilPanel}" Margin="0,10,10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                    <DockPanel>
                        <TextBlock Text="RADAR DISPLAY" Style="{StaticResource HeaderText}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="40NM" Style="{StaticResource MilButton}" Command="{Binding SetRadarRangePresetCommand}" CommandParameter="40"/>
                            <Button Content="80NM" Style="{StaticResource MilButton}" Command="{Binding SetRadarRangePresetCommand}" CommandParameter="80" Margin="6,0,0,0"/>
                            <Button Content="120NM" Style="{StaticResource MilButton}" Command="{Binding SetRadarRangePresetCommand}" CommandParameter="120" Margin="6,0,0,0"/>
                            <TextBlock Text="{Binding RadarCursorReadout}" Style="{StaticResource SmallText}" Margin="10,4,0,0"/>
                            <TextBlock Text="{Binding GameTime}" Style="{StaticResource SmallText}" Margin="10,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <controls:RadarDisplay x:Name="RadarScope"
                                       Grid.Row="1"
                                       Margin="8"
                                       Snapshot="{Binding CurrentSnapshot}"
                                       SelectedTrackId="{Binding SelectedTrackId, Mode=TwoWay}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource MilPanel}" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="MISSION CONTROL" Style="{StaticResource HeaderText}"/>
                    <TextBlock Text="{Binding MissionName}" Style="{StaticResource PrimaryText}" Margin="0,6,0,2"/>
                    <TextBlock Text="{Binding ThreatSummaryText}" Style="{StaticResource SmallText}" />
                    <TextBlock Text="{Binding WeatherSummary}" Style="{StaticResource SmallText}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding AlertLevelText, StringFormat=ALERT: {0}}" Style="{StaticResource WarningText}"/>
                    <TextBlock Text="{Binding RoeText, StringFormat=ROE: {0}}" Style="{StaticResource PrimaryText}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding AiModelText}" Style="{StaticResource SmallText}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding AiEndpointText}" Style="{StaticResource SmallText}" Margin="0,2,0,8"/>
                    <WrapPanel>
                        <Button Content="LOAD TUTORIAL" Style="{StaticResource MilButton}" Command="{Binding LoadScenarioCommand}" CommandParameter="tutorial"/>
                        <Button Content="LOAD OPS" Style="{StaticResource MilButton}" Command="{Binding LoadScenarioCommand}" CommandParameter="operation" Margin="6,0,0,0"/>
                        <Button Content="AI LINK" Style="{StaticResource MilButton}" Command="{Binding RefreshAiStatusCommand}" Margin="6,0,0,0"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="START" Style="{StaticResource MilButton}" Command="{Binding StartMissionCommand}" Margin="6,0,0,0"/>
                        <Button Content="PAUSE" Style="{StaticResource MilButton}" Command="{Binding PauseMissionCommand}" Margin="6,0,0,0"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="SEARCH" Style="{StaticResource MilButton}" Command="{Binding SetRadarSearchCommand}"/>
                        <Button Content="TWS" Style="{StaticResource MilButton}" Command="{Binding SetRadarTWSCommand}" Margin="6,0,0,0"/>
                        <Button Content="SILENT" Style="{StaticResource MilButton}" Command="{Binding SetRadarSilentCommand}" Margin="6,0,0,0"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource MilPanel}" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="WEAPONS" Style="{StaticResource HeaderText}"/>
                    <TextBlock Text="{Binding SelectedTrackId, StringFormat=TRACK: {0}}" Style="{StaticResource PrimaryText}" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding SelectedTrackBraa}" Style="{StaticResource SmallText}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding SelectedTrackThreatText}" Style="{StaticResource SmallText}" />
                    <TextBlock Text="{Binding SelectedTrackEnvelopeText}" Style="{StaticResource SmallText}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding ReadyLaunchers, StringFormat=READY LAUNCHERS: {0}}" Style="{StaticResource PrimaryText}" />
                    <TextBlock Text="{Binding ReserveMissiles, StringFormat=RESERVE MISSILES: {0}}" Style="{StaticResource PrimaryText}" />
                    <TextBlock Text="{Binding ConfirmedKills, StringFormat=CONFIRMED KILLS: {0}}" Style="{StaticResource PrimaryText}" />
                    <TextBlock Text="{Binding SelectedTrack.Classification, StringFormat=CLASS: {0}}" Style="{StaticResource SmallText}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding SelectedTrack.AspectString, StringFormat=ASPECT: {0}}" Style="{StaticResource SmallText}" />
                    <TextBlock Text="{Binding SelectedTrack.RangeNm, StringFormat=RANGE: {0:F1} NM}" Style="{StaticResource SmallText}" />
                    <TextBlock Text="{Binding SelectedTrack.SpeedKts, StringFormat=SPEED: {0:F0} KTS}" Style="{StaticResource SmallText}" />
                    <TextBlock Text="{Binding SelectedTrack.AltitudeFt, StringFormat=ALT: {0:F0} FT}" Style="{StaticResource SmallText}" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="DESIGNATE" Style="{StaticResource MilButton}" Command="{Binding DesignateSelectedCommand}"/>
                        <Button Content="FIRE 1" Style="{StaticResource EngageButton}" Command="{Binding FireSingleCommand}" Margin="6,0,0,0"/>
                        <Button Content="SALVO" Style="{StaticResource EngageButton}" Command="{Binding FireSalvoCommand}" Margin="6,0,0,0"/>
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding LauncherStates}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding LauncherId}" Style="{StaticResource PrimaryText}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StateText}" Style="{StaticResource SmallText}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding MissileType}" Style="{StaticResource SmallText}"/>
                                    <ProgressBar Grid.Column="3" Minimum="0" Maximum="1" Value="{Binding ReloadProgress}" Height="10" Margin="8,4,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource MilPanel}" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62"/>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="82"/>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ID" Style="{StaticResource HeaderText}"/>
                            <TextBlock Grid.Column="1" Text="DESIG" Style="{StaticResource HeaderText}"/>
                            <TextBlock Grid.Column="2" Text="CLASS" Style="{StaticResource HeaderText}"/>
                            <TextBlock Grid.Column="3" Text="BRG" Style="{StaticResource HeaderText}"/>
                            <TextBlock Grid.Column="4" Text="RNG" Style="{StaticResource HeaderText}"/>
                            <TextBlock Grid.Column="5" Text="ALT" Style="{StaticResource HeaderText}"/>
                            <TextBlock Grid.Column="6" Text="SPD" Style="{StaticResource HeaderText}"/>
                            <TextBlock Grid.Column="7" Text="THREAT" Style="{StaticResource HeaderText}"/>
                        </Grid>
                    </Border>
                    <ListView x:Name="ThreatList"
                              Grid.Row="1"
                              ItemsSource="{Binding ThreatBoardTracks}"
                              Background="Transparent"
                              BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="82"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TrackId}" Style="{StaticResource SmallText}" Foreground="{Binding RowBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Designation}" Style="{StaticResource SmallText}" Foreground="{Binding RowBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Classification}" Style="{StaticResource SmallText}" Foreground="{Binding RowBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Bearing}" Style="{StaticResource SmallText}" Foreground="{Binding RowBrush}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding RangeText}" Style="{StaticResource SmallText}" Foreground="{Binding RowBrush}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding AltitudeText}" Style="{StaticResource SmallText}" Foreground="{Binding RowBrush}"/>
                                    <TextBlock Grid.Column="6" Text="{Binding SpeedText}" Style="{StaticResource SmallText}" Foreground="{Binding RowBrush}"/>
                                    <TextBlock Grid.Column="7" Text="{Binding ThreatText}" Style="{StaticResource SmallText}" Foreground="{Binding RowBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource MilPanel}" Padding="10">
                <StackPanel>
                    <TextBlock Text="CREW" Style="{StaticResource HeaderText}" />
                    <ItemsControl ItemsSource="{Binding CrewDisplay}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="55"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource PrimaryText}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RoleText}" Style="{StaticResource SmallText}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource SmallText}" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource MilPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="44"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                    <DockPanel>
                        <TextBlock Text="COMMS LOG" Style="{StaticResource HeaderText}" />
                        <TextBlock Text="{Binding ActiveChannel, StringFormat=CHANNEL: {0}}" Style="{StaticResource SmallText}" HorizontalAlignment="Right"/>
                    </DockPanel>
                </Border>
                <ListView x:Name="CommsList"
                          Grid.Row="1"
                          ItemsSource="{Binding AllMessagesRecent}"
                          Margin="8,6,8,4">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding FormattedTime}" Style="{StaticResource SmallText}"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayHeader}" Style="{StaticResource PrimaryText}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Content}" Style="{StaticResource SmallText}" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <WrapPanel Grid.Row="2" Margin="8,0,8,6">
                    <Button Content="ACK" Style="{StaticResource MilButton}" Command="{Binding SendQuickCommandCommand}" CommandParameter="ack"/>
                    <Button Content="PICTURE" Style="{StaticResource MilButton}" Margin="6,0,0,0" Command="{Binding SendQuickCommandCommand}" CommandParameter="picture"/>
                    <Button Content="DECLARE" Style="{StaticResource MilButton}" Margin="6,0,0,0" Command="{Binding SendQuickCommandCommand}" CommandParameter="declare"/>
                    <Button Content="WEAP FREE" Style="{StaticResource MilButton}" Margin="6,0,0,0" Command="{Binding SendQuickCommandCommand}" CommandParameter="weapons_free"/>
                    <Button Content="SITREP" Style="{StaticResource MilButton}" Margin="6,0,0,0" Command="{Binding SendQuickCommandCommand}" CommandParameter="status"/>
                    <Button Content="INTEL" Style="{StaticResource MilButton}" Margin="6,0,0,0" Command="{Binding SendQuickCommandCommand}" CommandParameter="intel"/>
                </WrapPanel>
                <Grid Grid.Row="3" Margin="8,0,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="{Binding CommandChannelLabel}" Style="{StaticResource MilButton}" Command="{Binding SelectChannelCommand}" CommandParameter="{x:Static comms:RadioChannel.CommandNet}"/>
                    <Button Grid.Column="1" Content="{Binding BatteryChannelLabel}" Style="{StaticResource MilButton}" Margin="6,0,0,0" Command="{Binding SelectChannelCommand}" CommandParameter="{x:Static comms:RadioChannel.BatteryNet}"/>
                    <Button Grid.Column="2" Content="{Binding IntelChannelLabel}" Style="{StaticResource MilButton}" Margin="6,0,0,0" Command="{Binding SelectChannelCommand}" CommandParameter="{x:Static comms:RadioChannel.IntelNet}"/>
                    <TextBox x:Name="MessageInput"
                             Grid.Column="3"
                             Style="{StaticResource MilTextBox}"
                             Margin="8,0,0,0"
                             Text="{Binding InputMessage, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="4"
                            Content="SEND"
                            Style="{StaticResource MilButton}"
                            Margin="8,0,0,0"
                            Command="{Binding SendMessageCommand}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="DEADSKY.App.Views.TacticalMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DEADSKY.App.Controls"
        Title="DEADSKY Tactical Map"
        Height="720"
        Width="1120"
        Background="{StaticResource ConsoleBgBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3.55*"/>
            <ColumnDefinition Width="0.95*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource MilPanel}" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                    <DockPanel>
                        <TextBlock Text="TACTICAL MAP // KOVRAN LOWLANDS" Style="{StaticResource HeaderText}"/>
                        <TextBlock Text="{Binding GameTime}" Style="{StaticResource SmallText}" HorizontalAlignment="Right"/>
                    </DockPanel>
                </Border>
                <controls:TacticalMapDisplay x:Name="MapDisplay"
                                             Grid.Row="1"
                                             Margin="8"
                                             Snapshot="{Binding CurrentSnapshot}"
                                             Scenario="{Binding CurrentScenarioDefinition}"
                                             SelectedTrackId="{Binding SelectedTrackId}"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource MilPanel}" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="MAP STATUS" Style="{StaticResource HeaderText}"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Border Style="{StaticResource StatusBadge}">
                            <TextBlock Text="{Binding ThreatSummaryText}" Style="{StaticResource StatusBadgeText}"/>
                        </Border>
                        <Border Style="{StaticResource StatusBadge}">
                            <TextBlock Text="{Binding FireControlStatusText}" Style="{StaticResource StatusBadgeText}"/>
                        </Border>
                        <Border Style="{StaticResource StatusBadge}">
                            <TextBlock Text="{Binding MissileFlightStatusText}" Style="{StaticResource StatusBadgeText}"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="WHEEL ZOOM | RMB DRAG | MMB RESET | CLICK TRACK TO SYNC SELECTION"
                               Style="{StaticResource SubtleText}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource MilPanel}" Padding="10">
                <StackPanel>
                    <TextBlock Text="SELECTED TRACK" Style="{StaticResource HeaderText}"/>
                    <TextBlock Text="{Binding SelectedTrackId, StringFormat=TRACK {0}}" Style="{StaticResource PrimaryText}" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding SelectedTrackBraa}" Style="{StaticResource SmallText}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding SelectedTrackThreatText}" Style="{StaticResource WarningText}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding SelectedTrackEnvelopeText}" Style="{StaticResource AccentText}" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding SelectedTrackStatusText}" Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

<Window x:Class="DEADSKY.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DEADSKY Station Settings"
        Width="860"
        Height="640"
        MinWidth="760"
        MinHeight="560"
        Background="{StaticResource ConsoleBgBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource MilPanel}" Padding="12" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="STATION SETTINGS" Style="{StaticResource HeaderText}"/>
                    <TextBlock Text="Tune display and control behavior without crowding the combat station." Style="{StaticResource SmallText}" Margin="0,6,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Right"
                        Style="{StaticResource ChipBorder}"
                        Background="#182316"
                        BorderBrush="{StaticResource CardAccentGreenBrush}">
                    <TextBlock Text="LIVE CONFIG" Style="{StaticResource ChipText}"/>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="1.55*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource MilAccentCard}" BorderBrush="{StaticResource CardAccentBlueBrush}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="DISPLAY POSTURE" Style="{StaticResource HeaderText}"/>
                        <TextBlock Text="This console keeps non-combat preferences out of the main station so radar, fire control, and mission picture stay readable." Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="Map zoom stays independent from radar range. Resize protection now throttles redraw pressure during maximize and drag-resize actions." Style="{StaticResource AccentText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MilMetricCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="CURRENT POSTURE" Style="{StaticResource MetricLabelText}"/>
                        <TextBlock Text="{Binding FireControlHeadlineText}" Style="{StaticResource MetricValueText}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding RadarModeText}" Style="{StaticResource SmallText}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding RadarRangeStatusText}" Style="{StaticResource SmallText}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MilInsetCard}">
                    <StackPanel>
                        <TextBlock Text="OPERATOR NOTES" Style="{StaticResource HeaderText}"/>
                        <TextBlock Text="{Binding RecommendationText}" Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding TacticalMapNotesText}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <ScrollViewer Grid.Column="1" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource MilPanel}" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="DISPLAY MODE" Style="{StaticResource HeaderText}"/>
                            <TextBlock Text="Window and fullscreen display options." Style="{StaticResource SubtleText}" Margin="0,6,0,0"/>
                            <CheckBox x:Name="FullscreenCheckbox"
                                      Content="Fullscreen mode (borderless window)"
                                      Margin="0,12,0,0"
                                      Checked="OnFullscreenChecked"
                                      Unchecked="OnFullscreenUnchecked"/>
                            <TextBlock Text="Fullscreen mode removes window borders and maximizes to your entire screen. Press Alt+Enter to toggle fullscreen anytime." 
                                       Style="{StaticResource SmallText}" 
                                       TextWrapping="Wrap" 
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MilPanel}" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="SCOPE &amp; TARGETING" Style="{StaticResource HeaderText}"/>
                            <TextBlock Text="Controls that affect how the main fire-control station behaves." Style="{StaticResource SubtleText}" Margin="0,6,0,0"/>
                            <CheckBox Content="Auto-focus scope range to selected track"
                                      IsChecked="{Binding AutoFocusSelectedTrack}"
                                      Margin="0,12,0,0"/>
                            <CheckBox Content="Show altitude and speed labels on radar contacts"
                                      IsChecked="{Binding ShowRadarAltitudeLabels}"
                                      Margin="0,10,0,0"/>
                            <CheckBox Content="Show radar track trails and held-track memory lines"
                                      IsChecked="{Binding ShowRadarTrackTrails}"
                                      Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MilPanel}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="MAP &amp; PRESENTATION" Style="{StaticResource HeaderText}"/>
                            <TextBlock Text="Controls that affect the sector picture and information density." Style="{StaticResource SubtleText}" Margin="0,6,0,0"/>
                            <CheckBox Content="Show tactical map labels and sector notes"
                                      IsChecked="{Binding ShowTacticalMapLabels}"
                                      Margin="0,12,0,0"/>
                            <Border Style="{StaticResource MilInsetCard}" Margin="0,14,0,0" BorderBrush="{StaticResource CardAccentAmberBrush}">
                                <StackPanel>
                                    <TextBlock Text="PERFORMANCE SAFETY" Style="{StaticResource WarningText}"/>
                                    <TextBlock Text="Radar redraws are now throttled during window resize and maximize actions to keep the UI responsive under render pressure." Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
